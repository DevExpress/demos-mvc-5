@model string

@{DemoHelper.Instance.ControlAreaMaxWidth = Unit.Percentage(100);}

@section StartDemoRegion{
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@section DemoOptionsTop {
    <label>Choose mail merge mode:</label>

    <div class="options">
        <div class="options-item">
            @Html.DevExpress().RadioButtonList(
                settings => {
                    settings.Name = "MailMergeMode";
                    settings.Theme = DemoHelper.Instance.Theme;
                    settings.ControlStyle.Border.BorderStyle = System.Web.UI.WebControls.BorderStyle.None;
                    settings.Properties.ClientSideEvents.SelectedIndexChanged = "function(s, e) { $('form').submit(); }";
                }
            ).BindList(MailMergeDemoHelper.GetMailMergeModes()).Bind(Model).GetHtml()
        </div>
    </div>
}

@Html.Partial("MailMergePartial", Model)

@section EndDemoRegion{
    @{ Html.EndForm(); }
}
