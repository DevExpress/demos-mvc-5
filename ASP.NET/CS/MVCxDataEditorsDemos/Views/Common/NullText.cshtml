@model NullTextOptions

@{ 
    DemoHelper.Instance.ControlAreaMaxWidth = Unit.Pixel(400);
    DemoHelper.Instance.ControlOptionsRightBlockWidth = Unit.Pixel(400);
}

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@Html.DevExpress().FormLayout(settings => {
    settings.Name = "formLayout";
    settings.UseDefaultPaddings = false;    
    settings.Items.Add(i => {
        i.Caption = "Name";
        i.Width = Unit.Pixel(285);
        i.NestedExtension().ButtonEdit(s => {
            s.Name = "name";
            s.Width = Unit.Percentage(100);
            s.Properties.NullText = "Enter your name...";
            s.Properties.NullTextDisplayMode = Model.NullTextDisplayMode;
            s.Properties.ClearButton.DisplayMode = ClearButtonDisplayMode.OnHover;
        });
    });
    settings.Items.Add(i => {
        i.Caption = "Password";
        i.Width = Unit.Pixel(285);
        i.NestedExtension().ButtonEdit(s => {
            s.Name = "password";
            s.Width = Unit.Percentage(100);
            s.Properties.Password = true;
            s.Properties.NullText = "Enter your password...";
            s.Properties.NullTextDisplayMode = Model.NullTextDisplayMode;
            s.Properties.ClearButton.DisplayMode = ClearButtonDisplayMode.OnHover;
        });
    });
    settings.Items.Add(i => {
        i.Caption = "Product";
        i.Width = Unit.Pixel(285);
        i.NestedExtension().ComboBox(s => {
            s.Name = "product";
            s.Width = Unit.Percentage(100);
            s.Properties.NullText = "Choose item...";
            s.Properties.NullTextDisplayMode = Model.NullTextDisplayMode;
            s.Properties.DropDownStyle = DropDownStyle.DropDown;
            s.Properties.ClearButton.DisplayMode = ClearButtonDisplayMode.OnHover;
            for (int index = 1; index < 4; index++)
                s.Properties.Items.Add(string.Format("Item {0}", index), index);
        });
    });
    settings.Items.Add(i => {
        i.Caption = "Quantity";
        i.Width = Unit.Pixel(285);
        i.NestedExtension().SpinEdit(s => {
            s.Name = "quantity";
            s.Width = Unit.Percentage(100);
            s.Properties.NullText = "From 1 to 10...";
            s.Properties.NullTextDisplayMode = Model.NullTextDisplayMode;
            s.Properties.MinValue = 1;
            s.Properties.MaxValue = 10;
            s.Properties.ClearButton.DisplayMode = ClearButtonDisplayMode.OnHover;
        });
    });
    settings.Items.Add(i => {
        i.Caption = "Notes";
        i.Width = Unit.Pixel(285);
        i.NestedExtension().Memo(s => {
            s.Name = "notes";
            s.Width = Unit.Percentage(100);
            s.Properties.NullText = "If any...";
            s.Properties.NullTextDisplayMode = Model.NullTextDisplayMode;
            s.Height = Unit.Pixel(70);
        });
    });
    settings.Items.Add(i => {
        i.Caption = "";
        i.HorizontalAlign = FormLayoutHorizontalAlign.Right;
        i.Paddings.PaddingTop = Unit.Pixel(12);
        i.NestedExtension().Button(s => {
            s.Name = "clear";
            s.UseSubmitBehavior = false;
            s.Text = "Clear";
            s.ClientSideEvents.Click = "function(s, e) { ASPxClientEdit.ClearEditorsInContainer(formLayout.GetMainElement()); }";
        });
    });
}).GetHtml()

@section DemoOptions {
    @Html.DevExpress().FormLayout(settings => {
        settings.Name = "FormLayoutSettings";
        settings.RequiredMarkDisplayMode = RequiredMarkMode.None;
        settings.Items.AddGroupItem(g => {
            g.Caption = "Options";
            g.Items.Add(m => m.NullTextDisplayMode);
        });    
        DemoHelper.Instance.PrepareControlOptions(settings, new MvcControlOptionsSettings {
            ColumnMinWidth = 350,        
            ColumnCountMode = RecalculateColumnCountMode.ChildGroups
        });
    }).Bind(Model).GetHtml()
    <div class="apply-button-container">
        @Html.DevExpress().Button(s => {
            s.Name = "ApplyButton";
            s.Text = "Apply Changes";
            s.Theme = DemoHelper.Instance.Theme;
            s.UseSubmitBehavior = true;
        }).GetHtml()
    </div>
}

@section EndDemoRegion {
    @{ Html.EndForm(); }
}


