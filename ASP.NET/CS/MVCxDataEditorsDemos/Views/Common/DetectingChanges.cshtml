@model DetectingChangesModel

@functions{
    protected void PrepareCommonSettings(MVCxFormLayoutItem item) {
        item.Width = Unit.Pixel(400);
        item.CssClass = "smallScreenEditorsWidth";
    }
}

@section AdditionalResources {
    <script src="@Url.Content("~/Scripts/DirtyForm.js")" type="text/javascript"></script>
}

<script type="text/javascript">
    MVCxClientGlobalEvents.ControlsInitialized.AddHandler(onControlsInitialized);
</script>

@using (Html.BeginForm("DetectingChanges", "Common", FormMethod.Post, new { id = "detectingChanges", @class = "edit_form" })) {
    @Html.AntiForgeryToken()

    <h3>Change one of the editors to make a form dirty. On an attempt to close the form, the <b>onbeforeunload</b> event will be executed and the "Confirm" dialog will be displayed.</h3>
    <br />
    @Html.DevExpress().FormLayout(settings => {
        settings.Name = "FormLayout";
        settings.UseDefaultPaddings = false;
        settings.SettingsAdaptivity.AdaptivityMode = FormLayoutAdaptivityMode.SingleColumnWindowLimit;
        settings.SettingsAdaptivity.SwitchToSingleColumnAtWindowInnerWidth = 480;
        settings.Items.Add(m => m.TextBoxValue, i => {
            PrepareCommonSettings(i);
            i.NestedExtension().TextBox(s => {
                s.Width = Unit.Percentage(100);
                s.ControlStyle.CssClass = "smallScreenEditorsWidth";
            });        
        });
        settings.Items.Add(m => m.ComboBoxValue, i => {
            PrepareCommonSettings(i);
            i.NestedExtension().ComboBox(s => {
                s.Properties.Items.Add("Item 1", "1");
                s.Properties.Items.Add("Item 2", "2");
                s.Properties.Items.Add("Item 3", "3");
                s.Width = Unit.Percentage(100);
                s.ControlStyle.CssClass = "smallScreenEditorsWidth";
            });        
        });
        settings.Items.Add(m => m.DateEditValue, i => {
            PrepareCommonSettings(i);
            i.NestedExtension().DateEdit(s=> {
                s.Width = Unit.Percentage(100);
                s.ControlStyle.CssClass = "smallScreenEditorsWidth";
                s.Properties.CalendarProperties.FastNavProperties.DisplayMode = FastNavigationDisplayMode.Inline;
            });        
        });
        settings.Items.Add(m => m.TrackBarValue, i => {
            PrepareCommonSettings(i);
            i.NestedExtension().TrackBar(s => {
                s.Width = Unit.Percentage(100);
                s.ControlStyle.CssClass = "smallScreenEditorsWidth";
            });        
        });
    }).Bind(Model).GetHtml()
    <div class="buttonContainer">
        <div class="buttonContent">
            @Html.DevExpress().Button(btnSettings => {
                btnSettings.Name = "SaveButton";
                btnSettings.Text = "Save Changes";
                btnSettings.Width = Unit.Pixel(100);
                btnSettings.ClientEnabled = false;
                btnSettings.ClientSideEvents.Click = "onSubmitForm";
                btnSettings.UseSubmitBehavior = true;
                btnSettings.ControlStyle.CssClass = "buttonWidth";
            }).GetHtml()
        </div>
        <div class="buttonContent leftPadding topPadding">
            @Html.DevExpress().Button(btnSettings => {
                btnSettings.Name = "CancelButton";
                btnSettings.Text = "Cancel Changes";
                btnSettings.Width = Unit.Pixel(100);
                btnSettings.ClientEnabled = false;
                btnSettings.ClientSideEvents.Click = "cancelChanges";
                btnSettings.UseSubmitBehavior = false;
                btnSettings.ControlStyle.CssClass = "buttonWidth";
            }).GetHtml()
        </div>
    </div>
}





