@using DevExpress.Web.Demos
@model CheckListDemoOptions
@{
    DemoHelper.Instance.ControlAreaMaxWidth = Unit.Pixel(600);
    DemoHelper.Instance.ControlOptionsRightBlockWidth = Unit.Pixel(400);
}
@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@Html.DevExpress().RadioButtonList(settings => {
    settings.Name = "radioButtonList1";
    settings.Properties.ValueField = "ID";
    settings.Properties.TextField = "Name";
    settings.Properties.RepeatLayout = Model.RepeatLayout;
    settings.Properties.RepeatDirection = Model.RepeatDirection;
    settings.Properties.RepeatColumns = Model.RepeatColumns;
}).BindToXML(HttpContext.Current.Server.MapPath("~/App_Data/Languages.xml"), "//Language").GetHtml()

@section DemoOptions {
    @Html.DevExpress().FormLayout(settings => {
        settings.Name = "FormLayoutSettings";
        settings.RequiredMarkDisplayMode = RequiredMarkMode.None;
    
        settings.Items.AddGroupItem(g => {
            g.Caption = "Options";
            g.Items.Add(m => m.RepeatLayout, i => {
                i.NestedExtension().ComboBox(s => {
                    s.Properties.Items.Add("Table", 0);
                    s.Properties.Items.Add("Flow", 1);                    
                });
            });
            g.Items.Add(m => m.RepeatDirection);
            g.Items.Add(m => m.RepeatColumns, i => {
                i.NestedExtension().SpinEdit(s => {
                    s.Properties.MinValue = 1;
                    s.Properties.MaxValue = 6;
                    s.Properties.AllowNull = false;
                });
            });
        });
        DemoHelper.Instance.PrepareControlOptions(settings, new MvcControlOptionsSettings {
            ColumnMinWidth = 350,
            ColumnCountMode = RecalculateColumnCountMode.ChildGroups
        });
    }).Bind(Model).GetHtml()
    <div class="apply-button-container">
        @Html.DevExpress().Button(s => {
            s.Name = "ApplyButton";
            s.Text = "Apply Changes";
            s.Theme = DemoHelper.Instance.Theme;
            s.UseSubmitBehavior = true;
        }).GetHtml()
    </div>
}

@section EndDemoRegion {
    @{ Html.EndForm(); }
}