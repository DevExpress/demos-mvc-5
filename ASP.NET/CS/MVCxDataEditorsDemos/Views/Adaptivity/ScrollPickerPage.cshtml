@model ScrollPickerDemoOptions
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0" />
    <title>Scroll Pickers - ASP.NET MVC Data Editors</title>

    @Html.DevExpress().GetStyleSheets(
        new StyleSheet { ExtensionType = ExtensionType.FormLayout },
        new StyleSheet { ExtensionType = ExtensionType.DateEdit },
        new StyleSheet { ExtensionType = ExtensionType.CheckBox, Theme = DemoHelper.Instance.Theme },
        new StyleSheet { ExtensionType = ExtensionType.ComboBox, Theme = DemoHelper.Instance.Theme },
        new StyleSheet { ExtensionType = ExtensionType.Button, Theme = DemoHelper.Instance.Theme }
    )
    <link href="~/Content/deviceViewerContent.css" rel="stylesheet" />
    <script src="@Url.Content("~/Scripts/jquery.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")" type="text/javascript"></script>
    @Html.DevExpress().GetScripts(
        new Script { ExtensionType = ExtensionType.FormLayout },
        new Script { ExtensionType = ExtensionType.DateEdit },
        new Script { ExtensionType = ExtensionType.CheckBox },
        new Script { ExtensionType = ExtensionType.ComboBox },
        new Script { ExtensionType = ExtensionType.Button }
    )
</head>
<body>
    @using(Html.BeginForm()) {
        @Html.AntiForgeryToken()

        @Html.DevExpress().FormLayout(settings => {
            settings.Name = "layout";
            settings.Width = Unit.Percentage(100);

            settings.Items.AddGroupItem(group => {

                group.GroupBoxDecoration = GroupBoxDecoration.None;
                
                group.Items.AddGroupItem(gsp => {
                    gsp.Caption = "Scroll Picker";
                    gsp.GroupBoxDecoration = GroupBoxDecoration.HeadingLine;
                    
                    gsp.Items.Add(i => {
                        i.ShowCaption = DefaultBoolean.False;
                        i.NestedExtension().DateEdit(s => {
                            s.Name = "DateEdit";
                            s.Width = Unit.Percentage(100);
                            s.Date = DateTime.Today;
                            s.Theme = Utils.CurrentTheme;
                            s.Properties.SettingsAdaptivity.Mode = DropDownEditAdaptivityMode.OnWindowInnerWidth;
                            s.Properties.CalendarProperties.ShowTodayButton = false;
                            s.Properties.CalendarProperties.ShowClearButton = false;
                            s.Properties.PickerDisplayMode = Model.PickerDisplayMode.Value;
                            s.Properties.PickerType = Model.PickerType.Value;
                            s.Properties.TimeSectionProperties.Visible = Model.TimeSectionVisibility.Value;
                        });
                    });
                });
            });
        }).GetHtml()

        @Html.Partial("ScrollPickerPage_SettingsPartial")

    }

</body>
</html>
