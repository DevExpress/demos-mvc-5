@model IEnumerable
@{DemoHelper.Instance.ControlAreaMaxWidth = Unit.Percentage(100);}

@{
    var enableCheckedListMode = (bool)Session["EnableCheckedListMode"];
}
@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@section DemoOptionsTop {
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().CheckBox(cbSettings =>
            {
                cbSettings.Name = "EnableCheckedListMode";
                cbSettings.Text = "Enable CheckedList Mode";
                cbSettings.Theme = DemoHelper.Instance.Theme;
                cbSettings.ControlStyle.Wrap = DefaultBoolean.False;
                cbSettings.Properties.ClientSideEvents.CheckedChanged = "function(s, e){ $('form').submit(); }";
            }).Bind(enableCheckedListMode).GetHtml()
        </div>
    </div>
}
@Html.Partial("HeaderFilterPartial", Model)
@section EndDemoRegion {
    @{ Html.EndForm(); }
}