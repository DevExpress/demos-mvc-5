@{
    Html.DevExpress().CardView<Headphone>(settings => {
        settings.Name = "cardView";
        settings.CallbackRouteValues = new { Controller = "SortingAndGrouping", Action = "GroupingPartial" };
        settings.Width = Unit.Percentage(100);

        settings.Columns.Add(c => c.PhotoUrl).EditorProperties().Image(p => { });
        settings.Columns.Add(c => {
            c.FieldName = "Brand";
            c.GroupIndex = 0;
        });
        settings.Columns.Add(c => c.Fit);
        settings.Columns.Add("Power", "Power, MW");
        settings.Columns.Add(c => c.Discount).EditorProperties().SpinEdit(p => { p.DisplayFormatString = "{0}%"; });
        settings.Columns.Add(c => c.Price).EditorProperties().SpinEdit(p => { p.DisplayFormatString = "c"; });

        settings.CardLayoutProperties.Items.Add(i => {
            i.ColumnName = "PhotoUrl";
            i.ShowCaption = DefaultBoolean.False;
            i.HorizontalAlign = FormLayoutHorizontalAlign.Center;
        });
        settings.CardLayoutProperties.Items.Add("Fit");
        settings.CardLayoutProperties.Items.Add("Power");
        settings.CardLayoutProperties.Items.Add("Discount");
        settings.CardLayoutProperties.Items.Add("Price");

        settings.Settings.ShowGroupSelector = true;
        settings.Settings.ShowHeaderPanel = true;
        settings.SettingsPager.Mode = GridViewPagerMode.ShowAllRecords;
        settings.Settings.LayoutMode = DevExpress.Web.Layout.Breakpoints;
        settings.Styles.BreakpointsCard.Height = 320;

        settings.SettingsAdaptivity.BreakpointsLayoutSettings.CardsPerRow = 5;
        settings.SettingsAdaptivity.BreakpointsLayoutSettings.Breakpoints.Add(1400, 4);
        settings.SettingsAdaptivity.BreakpointsLayoutSettings.Breakpoints.Add(900, 3);
        settings.SettingsAdaptivity.BreakpointsLayoutSettings.Breakpoints.Add(700, 2);
        settings.SettingsAdaptivity.BreakpointsLayoutSettings.Breakpoints.Add(500, 1);
    }).Bind(Model).GetHtml();
}
