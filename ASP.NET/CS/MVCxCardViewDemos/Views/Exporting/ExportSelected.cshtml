@model IEnumerable
@{ DemoHelper.Instance.ControlAreaMaxWidth = Unit.Percentage(100); }

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}
@section AdditionalResources {
    <script type="text/javascript">
        function OnToolbarItemClick(s, e) {
            switch(e.item.name) {
                case 'custSelectAll':
                    cardView.SelectCards();
                    break;
                case 'custUnselectAll':
                    cardView.UnselectCards();
                    break;
                case 'custSelectAllOnPage':
                    cardView.SelectAllCardsOnPage();
                    break;
                case 'custUnselectAllOnPage':
                    cardView.UnselectAllCardsOnPage();
                    break;
            }
        }
    </script>
}
@Html.Partial("ExportSelectedPartial", Model)
@section EndDemoRegion {
    @{ Html.EndForm(); }
}