@model IEnumerable

<script type="text/javascript">
    function Grid_BeginCallback(s, e) {
        DXDemo.LoadAntiForgeryTokenInputValue(e.customArgs);
    }
</script>

@section DemoOptionsTop {
    <div id="options" class="options">
        <div class="options-item">
            @Html.DevExpress().ComboBox(s => {
                s.Name = "EditMode";
                s.Properties.Caption = "Edit mode:";
                s.Theme = DemoHelper.Instance.Theme;
                s.Properties.ValueType = typeof(CardViewEditingMode);
                s.Properties.ClientSideEvents.SelectedIndexChanged = "function(s,e) { CardView.PerformCallback({ editMode: s.GetValue() });}";
            }).BindList(EditingDemosHelper.AvailableEditModesList).Bind(EditingDemosHelper.EditMode).GetHtml()
        </div>
    </div>
}

@using (Html.BeginForm()){
    @Html.AntiForgeryToken()

    @Html.Partial("EditModesPartial", Model)
}