@model IEnumerable

          

@section DemoOptionsTop {
    <script type="text/javascript">
            function PerformCallback(s, e) {
                CardView.PerformCallback();
            }

            function OnCardViewBeginCallback(s, e) {
                e.customArgs["EndlessPagingMode"] = EndlessPagingMode.GetValue();
                e.customArgs["EnableScrolling"] = EnableScrolling.GetValue();
            }
    </script> 
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().CheckBox(s => {
               s.Name = "EnableScrolling";
               s.Text = "Enable scrolling";
               s.Theme = DemoHelper.Instance.Theme;
               s.Checked = PagingAndScrollingHelper.Options.EnableScrolling;
               s.Properties.ClientSideEvents.CheckedChanged = "PerformCallback";
           }).GetHtml()
        </div>

        <div class="options-item">
            @Html.DevExpress().ComboBox(s => {
               s.Name = "EndlessPagingMode";
               s.Properties.Caption = "Endless paging mode:";
               s.Theme = DemoHelper.Instance.Theme;
               s.Properties.DataSource = Enum.GetValues(typeof(CardViewEndlessPagingMode));
               s.SelectedIndex = 0;
               s.Properties.ClientSideEvents.ValueChanged = "PerformCallback";
           }).BindList(Enum.GetValues(typeof(CardViewEndlessPagingMode))).Bind(PagingAndScrollingHelper.Options.EndlessPagingMode.ToString()).GetHtml()
        </div>
    </div>
}
