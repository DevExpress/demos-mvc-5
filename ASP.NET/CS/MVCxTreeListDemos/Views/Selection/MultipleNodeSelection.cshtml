@model TreeListMultipleSelectionDemoOptions
                   
@section StartDemoRegion {
    @{ Html.BeginForm(); }
}
@section DemoOptionsTop {
    <script type="text/javascript">
        function OnChangeDemoOptions() {
            $('form').submit();
        }
        function OnBeginCallback(s, e) {
            e.customArgs = MVCxClientUtils.GetSerializedEditorValuesInContainer("options");
        }
    </script>
    <div id="options" class="options">
        <div class="options-item">
            @Html.DevExpress().CheckBoxFor(m => m.EnableRecursiveSelection, s => {
                s.Text = "Recursive";
                s.Theme = DemoHelper.Instance.Theme;
                s.Properties.ClientSideEvents.ValueChanged = "OnChangeDemoOptions";
            }).GetHtml()
        </div>
        <div class="options-item">
            @Html.DevExpress().CheckBoxFor(m => m.AllowSelectAll, s => {
                s.Text = "Show 'Select All' check box";
                s.Theme = DemoHelper.Instance.Theme;
                s.Properties.ClientSideEvents.ValueChanged = "OnChangeDemoOptions";
            }).GetHtml()
        </div>
        <div class="options-item">
            @Html.DevExpress().ComboBoxFor(m => m.SelectMode, s => {
               s.Properties.Caption = "Allow select:";
               s.Theme = DemoHelper.Instance.Theme;
               s.Properties.ValueType = typeof(string);
               s.Properties.ClientSideEvents.ValueChanged = "OnChangeDemoOptions";
           }).BindList(TreeListMultipleSelectionDemoHelper.GetSelectModes()).GetHtml()
        </div>
    </div>
}
@Html.Action("MultipleNodeSelectionPartial", new { options = Model })

@section EndDemoRegion {
    @{ Html.EndForm(); }
}
