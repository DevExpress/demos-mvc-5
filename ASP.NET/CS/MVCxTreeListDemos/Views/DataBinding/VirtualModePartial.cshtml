@Html.DevExpress().TreeList(settings => {
    settings.Name = "treeList";
    settings.CallbackRouteValues = new { Controller = "DataBinding", Action = "VirtualModePartial" };
    settings.Width = Unit.Percentage(10);

    settings.Columns.Add("name", "File name");
    settings.Columns.Add(c => {
        c.FieldName = "date";
        c.Caption = "Creation Date";
        c.Width = Unit.Percentage(100);
        c.PropertiesEdit.DisplayFormatString = "{0:g}";
    });
}).BindToVirtualData(TreeListVirtualModeHelper.VirtualModeCreateChildren, TreeListVirtualModeHelper.VirtualModeNodeCreating).GetHtml()


