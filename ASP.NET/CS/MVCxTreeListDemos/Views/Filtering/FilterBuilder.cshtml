@model IEnumerable

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@section DemoOptionsTop {
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().CheckBox(cbSettings => {
                cbSettings.Name = "EnableTextTab";
                cbSettings.Text = "Enable Text Tab";
                cbSettings.Theme = DemoHelper.Instance.Theme;
                cbSettings.ControlStyle.Wrap = DefaultBoolean.False;
                cbSettings.Properties.ClientSideEvents.CheckedChanged = "function(s, e){ $('form').submit(); }";
            }).Bind(ViewBag.EnableTextTab).GetHtml()
        </div>
    </div>
}

@Html.Partial("FilterBuilderPartial", Model)

@section EndDemoRegion {
    @{ Html.EndForm(); }
}

