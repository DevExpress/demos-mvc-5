@model ChartBoxPlotDemoOptions

@{
    ChartBoxPlotDemoOptions options = Model;
    if (options != null) {
        @Html.DevExpress().Chart(settings => {
       settings.Name = "chart";
       settings.Width = 920;
       settings.Height = 500;
       settings.PaletteName = "Office";
       settings.RenderFormat = DevExpress.XtraCharts.Web.RenderFormat.Svg;
       settings.BorderOptions.Visibility = DefaultBoolean.False;
       settings.CallbackRouteValues = new { controller = "AdvancedViewTypes", action = "BoxPlotPartial" };
       settings.SaveStateOnCallbacks = false;

       settings.Titles.Add(t => {
           t.DXFont = new DXFont("Tahoma", 18);
           t.Text = "Experiment Results";
       });

       settings.Legends.Default(l => {
           l.Border.Visibility = DefaultBoolean.False;
           l.AlignmentHorizontal = LegendAlignmentHorizontal.Left;
           l.AlignmentVertical = LegendAlignmentVertical.BottomOutside;
           l.HorizontalIndent = 10;
           l.Direction = LegendDirection.LeftToRight;
       });
       settings.CrosshairOptions.GroupHeaderPattern = "Experiment {A}";

       settings.XYDiagram(d => {
           d.AxisX.GridLines.MinorVisible = false;
           d.AxisX.NumericScaleOptions.AutoGrid = false;
           d.AxisX.NumericScaleOptions.GridAlignment = NumericGridAlignment.Ones;
           d.AxisX.NumericScaleOptions.GridSpacing = 1;
           d.AxisX.Tickmarks.MinorVisible = false;
           d.AxisX.Label.TextPattern = "Experiment {V}";
           d.AxisX.LabelVisibilityMode = AxisLabelVisibilityMode.AutoGeneratedAndCustom;
           d.AxisX.CustomLabels.Add(l => {
               l.Name = "Current Experiment";
               l.AxisValue = options.BoxPlotData.ExperimentNumber;
           });
           d.AxisX.Strips.Add(s => {
               s.MinLimit.AxisValue = options.BoxPlotData.ExperimentNumber - 0.5;
               s.MaxLimit.AxisValue = options.BoxPlotData.ExperimentNumber + 0.5;
               s.ShowInLegend = false;
           });
           d.SecondaryAxesX.Add(x => {
               x.Name = "Current experiment axis X";
               x.WholeRange.AutoSideMargins = false;
               x.WholeRange.SideMarginsValue = 1;
               x.Visibility = DefaultBoolean.False;
           });
           d.Panes.Add(p => {
               p.Name = "Current experiment pane";
               p.Title.Visibility = DefaultBoolean.True;
               p.RuntimeCollapse = DefaultBoolean.False;
               p.Title.Text = "Current Experiment";
           });
           d.AxisY.SetVisibilityInPane(false, d.Panes[0]);
           d.DefaultPane.Title.Visibility = DefaultBoolean.True;
           d.DefaultPane.RuntimeCollapse = DefaultBoolean.False;
           d.DefaultPane.Title.Text = "Experiment History";
           d.PaneLayout.ColumnDefinitions.Add(new LayoutDefinition());
           d.PaneLayout.ColumnDefinitions.Add(new LayoutDefinition() { SizeMode = PaneSizeMode.UseSizeInPixels, SizeInPixels = 175 });
           d.PaneLayout.AutoLayoutMode = PaneAutoLayoutMode.Grid;
       });

       settings.Series.Add(ser => {
           ser.Name = "Data Set 1";
           ser.Views().BoxPlotSeriesView(v => {
               v.FillStyle.FillMode = FillMode.Solid;
           });
           ser.DataSource = options.BoxPlotData.ExperimentResults1;
           ser.SetBoxPlotDataMembersWithOutliers(
               "ExperimentNumber",
               "Min",
               "Quartile1",
               "Median",
               "Quartile3",
               "Max",
               "Mean",
               "Outliers"
           );
           ser.CrosshairLabelPattern = "Minimum: {BP_Min: 0.}\nQuartile 1: {BP_Q1: 0.}\nMedian: {BP_MDN: 0.}\nAverage: {BP_AVG: 0.}\nQuartile 3: {BP_Q3: 0.}\nMaximum: {BP_MAX: 0.}";
       });
       settings.Series.Add(ser => {
           ser.Name = "Data Set 2";
           ser.Views().BoxPlotSeriesView(v => {
               v.FillStyle.FillMode = FillMode.Solid;
           });
           ser.DataSource = options.BoxPlotData.ExperimentResults2;
           ser.SetBoxPlotDataMembersWithOutliers(
               "ExperimentNumber",
               "Min",
               "Quartile1",
               "Median",
               "Quartile3",
               "Max",
               "Mean",
               "Outliers"
           );
           ser.CrosshairLabelPattern = "Minimum: {BP_Min: 0.}\nQuartile 1: {BP_Q1: 0.}\nMedian: {BP_MDN: 0.}\nAverage: {BP_AVG: 0.}\nQuartile 3: {BP_Q3: 0.}\nMaximum: {BP_MAX: 0.}";
       });
       settings.Series.Add(ser => {
           ser.Views().PointSeriesView(v => {
               settings.XYDiagram(d => {
                   v.Pane = d.Panes["Current experiment pane"];
                   v.AxisX = d.SecondaryAxesX["Current experiment axis X"];
                   Color color1 = settings.PaletteRepository[settings.PaletteName][0].Color;
                   v.PointMarkerOptions.FillStyle.FillMode = FillMode.Solid;
                   v.Color = Color.FromArgb(100, color1);
                   v.PointMarkerOptions.BorderVisible = false;
               });
           });
           ser.DataSource = options.BoxPlotData.CurrentExperimentRandomValues1;
           ser.SetDataMembers(
               "Argument",
               "Value"
           );
           ser.CrosshairEnabled = DefaultBoolean.False;
       });
       settings.Series.Add(ser => {
           ser.Views().PointSeriesView(v => {
               settings.XYDiagram(d => {
                   v.Pane = d.Panes["Current experiment pane"];
                   v.AxisX = d.SecondaryAxesX["Current experiment axis X"];
                   Color color2 = settings.PaletteRepository[settings.PaletteName][1].Color;
                   v.PointMarkerOptions.FillStyle.FillMode = FillMode.Solid;
                   v.Color = Color.FromArgb(100, color2);
                   v.PointMarkerOptions.BorderVisible = false;
               });
           });
           ser.DataSource = options.BoxPlotData.CurrentExperimentRandomValues2;
           ser.SetDataMembers(
               "Argument",
               "Value"
           );
           ser.CrosshairEnabled = DefaultBoolean.False;
       });
   }).Bind(null).GetHtml()
}}