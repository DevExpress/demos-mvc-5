@model ChartBarDemoOptions

@{ 
    DemoHelper.Instance.ControlAreaMaxWidth = Unit.Pixel(984);
    DemoHelper.Instance.ControlOptionsRightBlockWidth = Unit.Pixel(310);
}

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

<script type="text/javascript">
    function UpdateLabelOptionsState() {
        var showLabels = ShowLabels.GetChecked();
        LabelPosition.SetEnabled(showLabels);
        var labelPosition = LabelPosition.GetValue();
        LabelIndent.SetEnabled(showLabels && (labelPosition.indexOf('Inside') > 0));
        TextOrientation.SetEnabled(showLabels);
    }
    function OnBeginCallback(s, e) {
        e.customArgs = MVCxClientUtils.GetSerializedEditorValuesInContainer("SettingsFormLayout");
    }
</script>

@Html.Partial("BarViewPartial", Model)

@section DemoOptions {
    @Html.DevExpress().FormLayout(s => {
        s.Name = "SettingsFormLayout";
        s.RequiredMarkDisplayMode = RequiredMarkMode.None;
        s.Items.AddGroupItem(group => {
            group.Caption = "Labels Settings";
            group.Items.Add(model => model.ShowLabels, item => {
                item.NestedExtension().CheckBox(checkbox => {
                    checkbox.Properties.ClientSideEvents.CheckedChanged = "function(s, e) { UpdateLabelOptionsState(); }";
                });
            });
            group.Items.Add(model => model.LabelPosition, item => {
                item.NestedExtension().ComboBox(comboBox => {
                    comboBox.ClientEnabled = Model.ShowLabels;
                    comboBox.Properties.EnableClientSideAPI = true;
                    comboBox.Properties.Items.AddRange(ChartDemoHelper.GetBarLabelPositions(false));
                    comboBox.Properties.ClientSideEvents.ValueChanged = "function(s, e) { UpdateLabelOptionsState(); }";
                });
            });
            group.Items.Add(model => model.LabelIndent, item => {
                item.NestedExtension().SpinEdit(spinEdit => {
                    spinEdit.Properties.MinValue = 1;
                    spinEdit.Properties.MaxValue = 10000;
                    spinEdit.ClientEnabled = Model.ShowLabels && (Model.LabelPosition == BarSeriesLabelPosition.BottomInside || Model.LabelPosition == BarSeriesLabelPosition.TopInside);
                });
            });
            
            group.Items.Add(model => model.TextOrientation, item => {
                item.NestedExtension().ComboBox(comboBox => {
                    comboBox.ClientEnabled = Model.ShowLabels;
                    comboBox.Properties.EnableClientSideAPI = true;
                });
            });
        });
        DemoHelper.Instance.PrepareControlOptions(s, new MvcControlOptionsSettings { ColumnMinWidth = 290 });
    }).GetHtml()
    <div class="apply-button-container">
        @Html.DevExpress().Button(s => {
            s.Name = "ApplyButton";
            s.Text = "Apply Changes";
            s.Theme = DemoHelper.Instance.Theme;
            s.UseSubmitBehavior = true;
        }).GetHtml()
    </div>
}

@section EndDemoRegion {
    @{ Html.EndForm(); }
}
