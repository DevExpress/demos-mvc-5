@model ChartBarFullStackedDemoOptions

@{ 
    DemoHelper.Instance.ControlAreaMaxWidth = Unit.Pixel(984);
    DemoHelper.Instance.ControlOptionsRightBlockWidth = Unit.Pixel(340);
}

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@Html.DevExpress().Chart(settings => {
    ChartBarFullStackedDemoOptions options = Model;
    settings.Name = "chart";
    settings.Width = 920;
    settings.Height = 500;
    settings.PaletteName = "Office";
    settings.RenderFormat = DevExpress.XtraCharts.Web.RenderFormat.Svg;
    settings.BorderOptions.Visibility = DefaultBoolean.False;
    settings.CrosshairEnabled = options.ShowLabels ? DefaultBoolean.False : DefaultBoolean.True;

    settings.Legends.Default(l => {
        l.AlignmentHorizontal = LegendAlignmentHorizontal.Center;
        l.AlignmentVertical = LegendAlignmentVertical.BottomOutside;
        l.Direction = LegendDirection.LeftToRight;
        l.Border.Visibility = DefaultBoolean.False;
    });

    settings.Series.Template(t => {
        t.Views().FullStackedBarSeriesView(v => {
            v.SeriesLabel(l => {
                l.ResolveOverlappingMode = ResolveOverlappingMode.Default;
                l.TextPattern = options.ValueAsPercent ? "{VP:P0}" : "{V}K";
                l.DXFont = new DXFont("Tahoma", 8, DXFontStyle.Bold);
                l.Position = options.LabelPosition;
                l.TextOrientation = options.TextOrientation;
                l.Indent = options.LabelIndent;
            });
        });
        t.SetDataMembers("Region", "Sales");
        t.LabelsVisibility = options.ShowLabels ? DefaultBoolean.True : DefaultBoolean.False;
        t.CrosshairLabelPattern = "{S}: {V:0.0}K";
    });

    settings.XYDiagram(d => {
        d.AxisY.Interlaced = true;
        d.AxisY.Title.Visibility = DefaultBoolean.False;
        d.AxisY.WholeRange.SetMinMaxValues(0, 1);
        d.AxisY.WholeRange.SideMarginsValue = 0;
        d.AxisY.Label.TextPattern = "{VP:P0}";
        d.DefaultPane.StackedBarTotalLabel.Visible = options.ShowTotalLabels;
        d.DefaultPane.StackedBarTotalLabel.TextPattern = "Total\r\n{TV}K";
    });

    settings.Titles.Add(new ChartTitle() {
        Text = "DevAV Sales Region"
    });
}).Bind(Model.Data, seriesDataMember: "ProductCategory").GetHtml()

<script type="text/javascript">
    function UpdateLabelOptionsState() {
        var showLabels = ShowLabels.GetChecked();
        LabelPosition.SetEnabled(showLabels);
        var labelPosition = LabelPosition.GetValue();
        LabelIndent.SetEnabled(showLabels && (labelPosition.indexOf('Inside') > 0));
        TextOrientation.SetEnabled(showLabels);
        ValueAsPercent.SetEnabled(showLabels);
    }
</script>

@section DemoOptions {
    @Html.DevExpress().FormLayout(s => {
        s.Name = "SettingsFormLayout";
        s.RequiredMarkDisplayMode = RequiredMarkMode.None;
        s.Items.AddGroupItem(group => {
            group.Caption = "Labels Settings";
            group.Items.Add(model => model.ShowLabels, item => {
                item.NestedExtension().CheckBox(checkbox => {
                    checkbox.Properties.ClientSideEvents.CheckedChanged = "function(s, e) { UpdateLabelOptionsState(); }";
                });
            });
            group.Items.Add(model => model.ValueAsPercent, item => {
                item.NestedExtension().CheckBox(checkbox => { checkbox.ClientEnabled = Model.ShowLabels; });
            });
            group.Items.Add(model => model.LabelPosition, item => {
                item.NestedExtension().ComboBox(comboBox => {
                    comboBox.ClientEnabled = Model.ShowLabels;
                    comboBox.Properties.EnableClientSideAPI = true;
                    comboBox.Properties.Items.AddRange(ChartDemoHelper.GetBarLabelPositions(true));
                    comboBox.Properties.ClientSideEvents.ValueChanged = "function(s, e) { UpdateLabelOptionsState(); }";
                });
            });
            group.Items.Add(model => model.LabelIndent, item => {
                item.NestedExtension().SpinEdit(spinEdit => {
                    spinEdit.Properties.MinValue = 1;
                    spinEdit.Properties.MaxValue = 10000;
                    spinEdit.ClientEnabled = Model.ShowLabels && (Model.LabelPosition == BarSeriesLabelPosition.BottomInside || Model.LabelPosition == BarSeriesLabelPosition.TopInside);
                });
            });
            
            group.Items.Add(model => model.TextOrientation, item => {
                item.NestedExtension().ComboBox(comboBox => {
                    comboBox.ClientEnabled = Model.ShowLabels;
                    comboBox.Properties.EnableClientSideAPI = true;
                });
            });
            group.Items.Add(model => model.ShowTotalLabels);
        });
        DemoHelper.Instance.PrepareControlOptions(s, new MvcControlOptionsSettings { ColumnMinWidth = 320 });
    }).GetHtml()
    <div class="apply-button-container">
        @Html.DevExpress().Button(s => {
            s.Name = "ApplyButton";
            s.Text = "Apply Changes";
            s.Theme = DemoHelper.Instance.Theme;
            s.UseSubmitBehavior = true;
        }).GetHtml()
    </div>
}

@section EndDemoRegion {
    @{ Html.EndForm(); }
}
