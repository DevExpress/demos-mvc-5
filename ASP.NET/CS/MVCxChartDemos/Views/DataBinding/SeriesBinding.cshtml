@model ChartSeriesBindingDemoOptions

@{ 
    DemoHelper.Instance.ControlAreaMaxWidth = Unit.Pixel(984);
    DemoHelper.Instance.ControlOptionsRightBlockWidth = Unit.Pixel(330);
}

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()
    
@Html.DevExpress().Chart(settings => {
    ChartSeriesBindingDemoOptions options = Model;
    settings.Name = "chart";
    settings.Width = 920;
    settings.Height = 500;
    settings.PaletteName = "Office";
    settings.RenderFormat = DevExpress.XtraCharts.Web.RenderFormat.Svg;
    settings.BorderOptions.Visibility = DefaultBoolean.False;
    settings.CrosshairEnabled = options.ShowLabels ? DefaultBoolean.False : DefaultBoolean.True;
    
    settings.Legends.Default(l => {
        l.Visibility = DefaultBoolean.False;
    });

    settings.Series.Add(ser => {
        ser.Name = "Products";
        ser.SeriesPointsSortingKey = options.SortingKey;
        ser.SeriesPointsSorting = options.SortingMode;
        ser.SetDataMembers("ProductName", "UnitPrice");
        ser.LabelsVisibility = options.ShowLabels ? DefaultBoolean.True : DefaultBoolean.False;
    });       

    settings.XYDiagram(d=>{
        d.AxisX.Label.Angle = -30;
        d.AxisY.Title.Visibility = DefaultBoolean.True;
        d.AxisY.Title.Text = "Price";
        d.AxisY.Interlaced = true;
    });

    settings.Titles.Add(new ChartTitle() {
        Alignment = StringAlignment.Near,
        DXFont = new DXFont("Tahoma", 10),
        Text = "Category: " + options.Category
    });
    settings.Titles.Add(new ChartTitle() {
        Text = "Northwind Traders",
        DXFont = new DXFont("Tahoma", 18)
    });

    settings.BoundDataChanged = (sender, e) => {
        MVCxChartControl chart = (MVCxChartControl)sender;
        double max = double.NegativeInfinity;
        double min = double.PositiveInfinity;
        double average = 0;
        foreach (SeriesPoint point in chart.Series[0].Points) {
            if (point.Values[0] > max)
                max = point.Values[0];
            if (point.Values[0] < min)
                min = point.Values[0];
            average += point.Values[0];
        }
        average /= chart.Series[0].Points.Count;
        chart.Titles[0].Text += "\nMin price: " + min.ToString("0.00");
        chart.Titles[0].Text += "\nMax price: " + max.ToString("0.00");
        chart.Titles[0].Text += "\nAverage price: " + average.ToString("0.00");
    };
}).Bind(Model.Data).GetHtml()

@section DemoOptions {
    @Html.DevExpress().FormLayout(s => {
        s.Name = "SettingsFormLayout";
        s.RequiredMarkDisplayMode = RequiredMarkMode.None;
        s.Items.AddGroupItem(group => {
            group.Caption = "Data Settings";
            group.Items.Add(model => model.Category, item => {
                item.NestedExtension().ComboBox(comboBox => { comboBox.Properties.Items.AddRange(Model.Categories); });
            });
            group.Items.Add(model => model.SortingKey, item => {
                item.NestedExtension().ComboBox(comboBox => { comboBox.Properties.Items.AddRange(ChartDemoHelper.GetSortValues()); });
            });
            group.Items.Add(model => model.SortingMode);
        });
        s.Items.AddGroupItem(group => {
            group.Caption = "Labels Settings";
            group.Items.Add(model => model.ShowLabels);
        });
        DemoHelper.Instance.PrepareControlOptions(s, new MvcControlOptionsSettings {
            ColumnMinWidth = 310,
            ColumnCountMode = RecalculateColumnCountMode.RootGroup
        });
    }).GetHtml()
    <div class="apply-button-container">
        @Html.DevExpress().Button(s => {
            s.Name = "ApplyButton";
            s.Text = "Apply Changes";
            s.Theme = DemoHelper.Instance.Theme;
            s.UseSubmitBehavior = true;
        }).GetHtml()
    </div>
}

@section EndDemoRegion {
    @{ Html.EndForm(); }
}