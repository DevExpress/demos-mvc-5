@model CustomFileSystemProvider

@section AdditionalResources{
<style>
    .menu-container,
    .filemanager-container
    {
        display: table-cell;
        vertical-align: top;
    }
    .filemanager-container
    {
        width: 100%;
    }
</style>
}

<script type="text/javascript">
    function onFilterMenuItemClick(s, e) {
        var filterArg = e.item.name === 'All' ? "" : e.item.name + "|" + e.item.GetText();
        fileManager.PerformCallback({ filterArg: filterArg });
    }
</script>

@using(Html.BeginForm()) {
    <div class="menu-container">
        @Html.DevExpress().Menu(
            settings => {
                settings.Name = "FilterMenu";
                settings.AllowSelectItem = true;
                settings.Orientation = Orientation.Vertical;
                settings.Width = Unit.Pixel(170);
                settings.Height = Unit.Pixel(500);
                settings.ControlStyle.BorderRight.BorderWidth = 0;
                settings.ClientSideEvents.ItemClick = "onFilterMenuItemClick";

                settings.Items.Add("All", "All");
                settings.Items.Add("Recent", "Recent");
                settings.Items.Add("RTF Docs", "RTFDocs");
                settings.Items.Add("Sheets", "Sheets");
                settings.Items.Add("Images", "Images");
                settings.Items.Add("PDFs", "PDFs");
                settings.Items.Add("Favorites", "Favorites");
            }).GetHtml()
    </div>
    <div class="filemanager-container">
        @Html.Partial("CustomFilterAPIPartial", Model)
    </div>
    <br />
    <p class="Note">
        <b>Allowed Extensions</b>: .jpg, .jpeg, .gif, .rtf, .txt, .png, .doc, .docx, .pdf, .xls, .xlsx
    </p>
}
