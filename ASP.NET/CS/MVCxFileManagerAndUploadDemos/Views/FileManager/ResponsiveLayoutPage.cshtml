@model string
@{ Layout = null; }
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0" />
    <title>Responsive Layout - ASP.NET File Manager Control</title>
    @Html.DevExpress().GetStyleSheets(
        new StyleSheet { ExtensionType = ExtensionType.FileManager }
    )
    <script src="@Url.Content("~/Scripts/jquery.min.js")" type="text/javascript"></script>
    @Html.DevExpress().GetScripts(
        new Script { ExtensionType = ExtensionType.FileManager }
    )
    <style>
        html, body, form, .container
        {
            margin: 0;
            padding: 0;
            height: 100%;
        }
    </style>
</head>
<body>
    @using(Html.BeginForm()) {
        <div class="container">
            @Html.Partial("ResponsiveLayoutPagePartial", Model)
        </div>
    }
</body>
</html>
