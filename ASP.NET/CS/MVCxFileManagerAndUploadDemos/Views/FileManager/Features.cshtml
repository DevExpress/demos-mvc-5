@model string
@{ DemoHelper.Instance.ControlOptionsRightBlockWidth = Unit.Pixel(320); }
@{ FileManagerFeaturesDemoOptions options = FileManagerDemoHelper.FeaturesDemoOptions; }

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@section DemoOptions {
    @Html.Partial("FeaturesOptionsPartial", options)
}
@Html.Partial("FeaturesPartial", Model)
<p class="Note">
    <b>Allowed Extensions</b>: .jpg, .jpeg, .gif, .rtf, .txt, .avi, .png, .mp3, .xml, .doc, .pdf
</p>
@section EndDemoRegion{
    @{ Html.EndForm(); }
}
