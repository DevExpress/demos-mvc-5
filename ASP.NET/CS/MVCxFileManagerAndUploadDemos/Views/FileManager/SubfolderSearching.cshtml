@model string
           
<script type="text/javascript">
    MVCxClientGlobalEvents.AddControlsInitializedEventHandler(AttachEditorValueChangedEvent);

    function AttachEditorValueChangedEvent(){
        var demoOptionNames = [ "SearchFilesInSubfolders", "SearchResultView", "FileListView" ];
        $.each(demoOptionNames, function(i, name){
            var editor = ASPxClientControl.GetControlCollection().GetByName(name);
            editor.ValueChanged.AddHandler(OnChangeDemoOptions);
        });
    }
    function OnChangeDemoOptions(){
        $("form").submit();
    }
</script>
@{DemoHelper.Instance.ControlAreaMaxWidth = Unit.Pixel(1600);}

@section StartDemoRegion{
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@Html.Partial("SubfolderSearchingPartial", Model)

@section DemoOptionsTop {
    <div id="options" class="options">
        <div class="options-item">
            @Html.DevExpress().ComboBox(s => {
           s.Name = "FileListView";
           s.Properties.Caption = "File list view:";
           s.Theme = DemoHelper.Instance.Theme;
           s.Properties.ValueType = typeof(FileListView);
       }).BindList(Enum.GetNames(typeof(FileListView))).Bind(FileManagerDemoHelper.SubfolderSearchingDemoOptions.FileListView).GetHtml()
        </div>
        <div class="options-item">
            @Html.DevExpress().ComboBox(s => {
           s.Name = "SearchResultView";
           s.Properties.Caption = "Search result view:";
           s.Theme = DemoHelper.Instance.Theme;
           s.Properties.ValueType = typeof(FileManagerFilteredFileListViewMode);
       }).BindList(Enum.GetNames(typeof(FileManagerFilteredFileListViewMode))).Bind(FileManagerDemoHelper.SubfolderSearchingDemoOptions.SearchResultView).GetHtml()
        </div>
        <div class="options-item">
            @Html.DevExpress().CheckBox(s => {
           s.Name = "SearchFilesInSubfolders";
           s.Text = "Search files in subfolders";
           s.Theme = DemoHelper.Instance.Theme;
       }).Bind(FileManagerDemoHelper.SubfolderSearchingDemoOptions.SearchFilesInSubfolders).GetHtml()
        </div>
    </div>
}

 @section EndDemoRegion{ 
    @{ Html.EndForm(); }
}