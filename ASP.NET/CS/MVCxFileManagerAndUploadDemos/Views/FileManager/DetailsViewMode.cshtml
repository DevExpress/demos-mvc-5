@model ArtsFileSystemProvider
@{ DemoHelper.Instance.ControlOptionsRightBlockWidth = Unit.Pixel(270); }

<script type="text/javascript">
    function SubmitForm(s, e) {
        $("form").submit();
    }
</script>

@{ FileManagerDetailsViewModeDemoOptions options = (FileManagerDetailsViewModeDemoOptions)Session["Options"]; }


@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@section DemoOptions {
    @Html.DevExpress().FormLayout(settings =>
    {
        settings.Name = "OptionsFormLayout";
        settings.Items.AddGroupItem(g =>
        {
            g.Caption = "Options";
            g.Width = Unit.Percentage(100);
            g.Items.Add(i =>
            {
                i.Caption = "AllowColumnResize";
                i.SetNestedContent(() =>
                {
                    Html.DevExpress().CheckBox(rbSettings =>
                    {
                        rbSettings.Name = "AllowColumnResize";
                        rbSettings.Theme = DemoHelper.Instance.Theme;
                        rbSettings.Properties.ClientSideEvents.CheckedChanged = "SubmitForm";
                    }).Bind(options.AllowColumnResize).Render();
                });
            });
            g.Items.Add(i =>
            {
                i.Caption = "AllowColumnDragDrop";
                i.SetNestedContent(() =>
                {
                    Html.DevExpress().CheckBox(rbSettings =>
                    {
                        rbSettings.Name = "AllowColumnDragDrop";
                        rbSettings.Theme = DemoHelper.Instance.Theme;
                        rbSettings.Properties.ClientSideEvents.CheckedChanged = "SubmitForm";
                    }).Bind(options.AllowColumnDragDrop).Render();
                });
            });
            g.Items.Add(i =>
            {
                i.Caption = "AllowColumnSort";
                i.SetNestedContent(() =>
                {
                    Html.DevExpress().CheckBox(rbSettings =>
                    {
                        rbSettings.Name = "AllowColumnSort";
                        rbSettings.Theme = DemoHelper.Instance.Theme;
                        rbSettings.Properties.ClientSideEvents.CheckedChanged = "SubmitForm";
                    }).Bind(options.AllowColumnSort).Render();
                });
            });
            g.Items.Add(i =>
            {
                i.Caption = "ShowHeaderFilterButton";
                i.SetNestedContent(() =>
                {
                    Html.DevExpress().CheckBox(rbSettings =>
                    {
                        rbSettings.Name = "ShowHeaderFilterButton";
                        rbSettings.Theme = DemoHelper.Instance.Theme;
                        rbSettings.Properties.ClientSideEvents.CheckedChanged = "SubmitForm";
                    }).Bind(options.ShowHeaderFilterButton).Render();
                });
            });
        });
        DemoHelper.Instance.PrepareControlOptions(settings, new MvcControlOptionsSettings
        {
            ColumnMinWidth = 250,
            ColumnCountMode = RecalculateColumnCountMode.ChildGroups
        });
    }).GetHtml()
}
@Html.Partial("DetailsViewModePartial", Model)
<br />
<p class="Note">
    <b>Allowed Extensions</b>: .jpg, .jpeg, .gif, .rtf, .txt, .avi, .png, .mp3, .xml, .doc, .pdf
</p>
@section EndDemoRegion{
    @{ Html.EndForm(); }
}


