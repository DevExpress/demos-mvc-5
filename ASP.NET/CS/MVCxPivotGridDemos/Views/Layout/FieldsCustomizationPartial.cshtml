@using DevExpress.Web.Demos.Mvc
@model PivotGridFieldsCustomizationDemoOptions

@Html.DevExpress().PivotGrid(
    settings =>
    {
        settings.Name = "pivotGrid";
        settings.OptionsData.DataProcessingEngine = PivotDataProcessingEngine.Optimized;
        settings.OptionsFilter.FilterPanelMode = FilterPanelMode.Filter;
        settings.CallbackRouteValues = new { Controller = "Layout", Action = "FieldsCustomizationPartial" };
        settings.OptionsView.HorizontalScrollBarMode = ScrollBarMode.Auto;
        settings.OptionsCustomization.AllowDrag = true;
        settings.OptionsCustomization.AllowDragInCustomizationForm = true;
        settings.CustomizationFieldsLeft = 600;
        settings.CustomizationFieldsTop = 400;
        settings.CustomizationFieldsVisible = true;
        settings.Width = Unit.Percentage(100);

        if (Model != null) {
            settings.OptionsCustomization.CustomizationFormStyle = Model.CustomizationFormStyle;
            settings.OptionsCustomization.CustomizationFormLayout = Model.CustomizationFormLayout;
            settings.OptionsCustomization.AllowDrag = Model.AllowDragFields;
            settings.OptionsCustomization.AllowDragInCustomizationForm = Model.AllowDragFieldsInCustomizationForm;
        }

        settings.Fields.Add(field => {
            field.Area = PivotArea.RowArea;
            field.AreaIndex = 0;
            field.Caption = "Order Quarter";
            field.DataBinding = new DataSourceColumnBinding("OrderDate", PivotGroupInterval.DateQuarter);
            field.ValueFormat.FormatString = "Qtr {0}";
            field.ValueFormat.FormatType = FormatType.Numeric;
        });
        settings.Fields.Add(field => {
            field.Area = PivotArea.RowArea;
            field.AreaIndex = 1;
            field.Caption = "Category Name";
            field.DataBinding = new DataSourceColumnBinding("CategoryName");
        });
        settings.Fields.Add(field => {
            field.Area = PivotArea.ColumnArea;
            field.AreaIndex = 0;
            field.DataBinding = new DataSourceColumnBinding("Country");
        });
        settings.Fields.Add(field => {
            field.Area = PivotArea.DataArea;
            field.AreaIndex = 0;
            field.Caption = "Order Amount";
            field.DataBinding = new ExpressionDataBinding("[UnitPrice] * [Quantity]");
            field.CellFormat.FormatType = FormatType.Numeric;
            field.CellFormat.FormatString = "c";
        });
        settings.Fields.Add(field => {
            field.Area = PivotArea.DataArea;
            field.AreaIndex = 1;
            field.DataBinding = new DataSourceColumnBinding("Quantity");
        });
        settings.Fields.Add(field => {
            field.AreaIndex = 0;
            field.Caption = "Order Year";
            field.DataBinding = new DataSourceColumnBinding("OrderDate", PivotGroupInterval.DateYear);
        });
        settings.Fields.Add(field => {
            field.AreaIndex = 1;
            field.Caption = "Product Name";
            field.DataBinding = new DataSourceColumnBinding("ProductName");
            field.Visible = false;
        });
        settings.Fields.Add(field => {
            field.AreaIndex = 1;
            field.Caption = "Sales Person";
            field.DataBinding = new DataSourceColumnBinding("Sales_Person");
            field.Visible = false;
        });
        settings.ClientSideEvents.CustomizationFieldsVisibleChanged = "onCustomizationFieldsVisibleChanged";
        settings.ClientSideEvents.BeginCallback = "onBeginCallback";
        settings.BeforeGetCallbackResult = (sender, e) => {
            ((MVCxPivotGrid)sender).OptionsCustomization.CustomizationFormStyle = Model.CustomizationFormStyle;
            ((MVCxPivotGrid)sender).OptionsCustomization.CustomizationFormLayout = Model.CustomizationFormLayout;
            ((MVCxPivotGrid)sender).OptionsCustomization.AllowDrag = Model.AllowDragFields;
            ((MVCxPivotGrid)sender).OptionsCustomization.AllowDragInCustomizationForm = Model.AllowDragFieldsInCustomizationForm;
        };
    }).Bind(NorthwindDataProvider.GetSalesPerson()).GetHtml()