@model IEnumerable

@{DemoHelper.Instance.ControlAreaMaxWidth = Unit.Percentage(100);}

@Html.DevExpress().RoundPanel(
    settings => {
        settings.Name = "roundPanel";
        settings.HeaderText = "Complex Pivot Table" ;
        settings.SetContent(() => {
            ViewContext.Writer.Write("<div><div style=\"float:left; padding-right:5px; padding-bottom:10px;\">");
                Html.DevExpress().PivotCustomizationExtension(PivotGridLayoutDemosHelper.CompactLayoutPivotGridSettings).Render();
            ViewContext.Writer.Write("</div><div style=\"float:right; padding-left:5px; padding-bottom:10px;\">");
                Html.RenderPartial("CompactLayoutPartial", Model);
            ViewContext.Writer.Write("</div></div>");
        });
    }).GetHtml()