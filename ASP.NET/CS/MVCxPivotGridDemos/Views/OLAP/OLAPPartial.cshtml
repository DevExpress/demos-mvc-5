@Html.DevExpress().PivotGrid(
    settings =>
    {
        settings.Name = "pivotGrid";
        settings.CallbackRouteValues = new { Controller = "OLAP", Action = "OLAPPartial" };
        settings.Width = Unit.Percentage(100);
        settings.CustomizationFieldsLeft = 600;
        settings.CustomizationFieldsTop = 400;
        settings.OptionsView.HorizontalScrollBarMode = ScrollBarMode.Auto;
        
        settings.Fields.Add(field => {
            field.Area = PivotArea.RowArea;
            field.AreaIndex = 0;
            field.Caption = "Category Name";
            field.DataBinding = new DataSourceColumnBinding("[Categories].[Category Name].[Category Name]");
            field.SortMode = PivotSortMode.None;
        });
        settings.Fields.Add(field => {
            field.Area = PivotArea.FilterArea;
            field.AreaIndex = 0;
            field.Caption = "City";
            field.DataBinding = new DataSourceColumnBinding("[Customers].[City].[City]");
            field.SortMode = PivotSortMode.None;
        });
        settings.Fields.Add(field => {
            field.Area = PivotArea.ColumnArea;
            field.AreaIndex = 0;
            field.Caption = "Country";
            field.DataBinding = new DataSourceColumnBinding("[Customers].[Country].[Country]");
            field.SortMode = PivotSortMode.None;
        });
        settings.Fields.Add(field => {
            field.Area = PivotArea.RowArea;
            field.AreaIndex = 1;
            field.Caption = "Products";
            field.DataBinding = new DataSourceColumnBinding("[Products].[Products].[Products]");
            field.SortMode = PivotSortMode.None;
        });
        settings.Fields.Add(field => {
            field.Area = PivotArea.DataArea;
            field.AreaIndex = 0;
            field.Caption = "Quantity";
            field.DataBinding = new DataSourceColumnBinding("[Measures].[Quantity]");
            field.CellFormat.FormatString = "#.##";
            field.CellFormat.FormatType = FormatType.Custom;
        });
        settings.Fields.Add(field => {
            field.Area = PivotArea.DataArea;
            field.AreaIndex = 1;
            field.Caption = "Discount";
            field.DataBinding = new DataSourceColumnBinding("[Measures].[Discount]");
            field.CellFormat.FormatString = "{0:f2}%";
            field.CellFormat.FormatType = FormatType.Custom;
        });
    }).BindToOLAP(PivotGridOLAPDemosHelper.OLAPConnectionString).GetHtml()