@model IEnumerable

@functions{
    IList<string> SortFields {
        get { return new List<string>() { "Order Amount", "Quantity", "Discount (Avg)" }; }
    }
    int GetSelectedIndex() {
        int index = SortFields.IndexOf(Session["SortField"].ToString());
        return index >= 0 ? index : 0;
    }
}
@section AdditionalResources{
    <script type="text/javascript">
        function submit() {
            $("form").submit();
        }
    </script>
}

@{ DemoHelper.Instance.ControlAreaMaxWidth = Unit.Percentage(80); }

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@section DemoOptionsTop {
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().ComboBox(s => {
           s.Name = "SortByField";
           s.Properties.Caption = "Sort the \"Sales Person\" Field by:";
           s.Theme = DemoHelper.Instance.Theme;
           s.SelectedIndex = GetSelectedIndex();
           s.Properties.ClientSideEvents.ValueChanged = "submit";
       }).BindList(SortFields).GetHtml()
        </div>
    </div>
}

@Html.Partial("SortBySummaryPartial", Model)

@section EndDemoRegion {
    @{ Html.EndForm(); }
}
