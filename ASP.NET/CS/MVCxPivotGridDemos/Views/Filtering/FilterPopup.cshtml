@model IEnumerable

@section DemoOptionsTop {
    <script>
        function onValueChanged() {
            pivotGridWithFilterPopup.PerformCallback({
                showOnlyAvailableItems: showOnlyAvailableItems.GetValue(),
                showListBoxSearchUI: showListBoxSearchUI.GetValue()
            });            
        }
    </script>
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().CheckBox(s => {
                s.Name = "showOnlyAvailableItems";
                s.Text = "Show Only Available Items";
                s.Properties.ClientSideEvents.ValueChanged = "onValueChanged";
                s.Theme = DemoHelper.Instance.Theme;
            }).Bind(true).GetHtml()
        </div>
        <div class="options-item">
            @Html.DevExpress().CheckBox(s => {
                s.Name = "showListBoxSearchUI";
                s.Text = "Show Search UI";
                s.Properties.ClientSideEvents.ValueChanged = "onValueChanged";
                s.Theme = DemoHelper.Instance.Theme;
            }).Bind(true).GetHtml()
        </div>
    </div>
}

<div id="pivotGrid-wrapper">
    @Html.Action("FilterPopupPartial")
</div>