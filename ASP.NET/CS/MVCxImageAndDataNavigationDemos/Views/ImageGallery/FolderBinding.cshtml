@model ImageGalleryFolderBindingDemoOptions

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@section DemoOptionsTop {
    <script type="text/javascript">
        function onOptionsChanged() {
            $("form").submit();
        }
    </script>
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().ComboBoxFor(m => m.ImageSourceFolder, s => {
                s.Properties.Caption = "Select folder:";
                s.Theme = DemoHelper.Instance.Theme;
                s.Properties.ClientSideEvents.ValueChanged = "onOptionsChanged";
            }).BindList(Model.ImageSourceFolders).GetHtml()
        </div>
        <div class="options-item">
            @Html.DevExpress().CheckBoxFor(m => m.ApplyWatermark, s => {
                s.Text = "Apply watermark:";
                s.Theme = DemoHelper.Instance.Theme;
                s.Properties.ClientSideEvents.ValueChanged = "onOptionsChanged";
            }).GetHtml()
        </div>
    </div>
}

@Html.Partial("FolderBindingPartial", Model)

@section EndDemoRegion {
    @{ Html.EndForm(); }
}