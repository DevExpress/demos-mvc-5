@model string

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@section DemoOptionsTop {
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().ComboBox(s => {
                s.Name = "Folder";
                s.Properties.Caption = "Select folder:";
                s.Theme = DemoHelper.Instance.Theme;
                s.Properties.ClientSideEvents.SelectedIndexChanged = "function(){ $('form').submit(); }";
            }).BindList(ImageSliderDemoHelper.GetSourceFolders()).Bind(Model).GetHtml()
        </div>
    </div>
}

@Html.DevExpress().ImageSlider(settings => {
    settings.Name = "imageSlider";
    settings.EnableTheming = false;
}).BindToFolder(Model).GetHtml()

@section EndDemoRegion {
    @{ Html.EndForm(); }
}