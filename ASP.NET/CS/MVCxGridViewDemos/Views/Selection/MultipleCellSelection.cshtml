@model IEnumerable

<script type="text/javascript">
    function onSpreadsheetInit(s, e) {
        var statusBarHeight = document.getElementsByClassName('statusbar')[0].clientHeight;
        s.SetHeight(grid.GetHeight() - statusBarHeight);
    }
</script>

@Html.DevExpress().FormLayout(settings => {
    settings.Name = "detailFormLayout";
    settings.SettingsAdaptivity.AdaptivityMode = FormLayoutAdaptivityMode.SingleColumnWindowLimit;
    settings.SettingsAdaptivity.SwitchToSingleColumnAtWindowInnerWidth = 700;
    settings.SettingsItems.ShowCaption = DefaultBoolean.False;
    settings.Width = Unit.Percentage(100);
    settings.ColumnCount = 2;
    settings.UseDefaultPaddings = false;

    settings.Items.Add(item => {
        item.Width = Unit.Percentage(65);
    }).SetNestedContent(() => {
        Html.RenderPartial("MultipleCellSelectionPartial", Model);
    });
    settings.Items.Add(item => {
        item.Width = Unit.Percentage(35);
    }).SetNestedContent(() => {
        Html.RenderPartial("MultipleCellSelectionSpreadsheetPartial");
    });

}).GetHtml()

            
