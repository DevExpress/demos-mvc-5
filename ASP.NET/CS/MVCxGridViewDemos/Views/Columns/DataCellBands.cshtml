@model IEnumerable
@section DemoOptionsTop {
    <script type="text/javascript">
        function OnDemoOptionsChanged(s, e) {
            grid.PerformCallback();
        }
        function OnBeginGridCallback(s, e) {
            e.customArgs['columnMoveMode'] = ColumnMoveMode.GetValue();
        }
    </script>
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().ComboBox(settings => {
                settings.Name = "ColumnMoveMode";
                settings.Theme = DemoHelper.Instance.Theme;
                settings.Properties.Caption = "ColumnMoveMode";
                settings.Properties.ValueType = typeof(GridColumnMoveMode);
                settings.Properties.ClientSideEvents.ValueChanged = "OnDemoOptionsChanged";
            }).BindList(Enum.GetValues(typeof(GridColumnMoveMode))).Bind(ViewBag.ColumnMoveMode).GetHtml()
        </div>
    </div>
}
@Html.Partial("DataCellBandsPartial", Model)

@section AdditionalResources {
    <style type="text/css">
        .price-cell {
            font-size: 1.6em;
            font-weight: 600;
            text-align: center !important;
        }
        .address-cell {
            font-size: 1.3em;
            font-weight: 600;
        }
    </style>
}
