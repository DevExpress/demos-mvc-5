
@model IEnumerable
@section DemoOptionsTop {
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().ComboBox(s => {
                s.Name = "GroupBy";
                s.Properties.Caption = "Group by";
                s.Theme = DemoHelper.Instance.Theme;
                s.SelectedIndex = 0;
                s.Properties.Items.Add("Country", 0);
                s.Properties.Items.Add("Country, City", 1);
                s.Properties.Items.Add("Company Name", 2);
                s.Properties.ClientSideEvents.SelectedIndexChanged = "function(s) { gvGrouping.PerformCallback({'param': s.GetValue()}) }";
            }).GetHtml()
        </div>
        <div class="options-item">
            @Html.DevExpress().Button(s => {
                s.Name = "ButtonCollapse";
                s.Text = "Collapse All Rows";
                s.Width = Unit.Pixel(180);
                s.Theme = DemoHelper.Instance.Theme;
                s.UseSubmitBehavior = false;
                s.ClientSideEvents.Click = "function() { gvGrouping.CollapseAll() }";
            }).GetHtml()
        </div>
        <div class="options-item">
            @Html.DevExpress().Button(s => {
                s.Name = "ButtonExpand";
                s.Text = "Expand All Rows";
                s.Width = Unit.Pixel(180);
                s.Theme = DemoHelper.Instance.Theme;
                s.UseSubmitBehavior = false;
                s.ClientSideEvents.Click = "function() { gvGrouping.ExpandAll() }";
            }).GetHtml()
        </div>
    </div>
}
@Html.Partial("GroupingPartial", Model)
