@{
    Html.EnableClientValidation();
    Html.EnableUnobtrusiveJavaScript();
}
@Html.DevExpress().GridView(settings => {
    settings.Name = "GridView";
    settings.CallbackRouteValues = new { Controller = "Adaptivity", Action = "ResponsiveLayoutPagePartial" };
    settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "Adaptivity", Action = "ResponsiveLayoutAddNewPartial" };
    settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "Adaptivity", Action = "ResponsiveLayoutUpdatePartial" };
    settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "Adaptivity", Action = "ResponsiveLayoutDeletePartial" };
    settings.Width = Unit.Percentage(100);
    settings.EnableRowsCache = false;

    settings.Settings.VerticalScrollBarMode = ScrollBarMode.Visible;
    settings.Settings.VerticalScrollableHeight = 500;

    settings.SettingsAdaptivity.AdaptivityMode = GridViewAdaptivityMode.HideDataCells;
    settings.SettingsAdaptivity.AllowOnlyOneAdaptiveDetailExpanded = true;
    settings.EditFormLayoutProperties.SettingsAdaptivity.AdaptivityMode = FormLayoutAdaptivityMode.SingleColumnWindowLimit;
    settings.EditFormLayoutProperties.SettingsAdaptivity.SwitchToSingleColumnAtWindowInnerWidth = 600;
	settings.SettingsBehavior.AllowEllipsisInText = true;

    settings.SettingsEditing.Mode = GridViewEditingMode.EditForm;
    settings.CommandColumn.Visible = true;
    settings.CommandColumn.ShowNewButtonInHeader = true;
    settings.CommandColumn.ShowDeleteButton = true;
    settings.CommandColumn.ShowEditButton = true;
    settings.CommandColumn.AdaptivePriority = 3;
    settings.CommandColumn.MinWidth = 100;
    settings.CommandColumn.MaxWidth = 160;
    settings.CommandColumn.Width = Unit.Percentage(18);

    settings.KeyFieldName = "ProductID";
    settings.Columns.Add(c => {
        c.FieldName = "ProductName";
        c.AllowTextTruncationInAdaptiveMode = true;
        c.MinWidth = 230;
        c.MaxWidth = 400;
        c.Width = Unit.Percentage(27);
    });
    settings.Columns.Add(c => {
        c.FieldName = "CategoryID";
        c.Caption = "Category Name";
        c.AdaptivePriority = 1;
        c.MinWidth = 100;
        c.MaxWidth = 250;
        c.Width = Unit.Percentage(18);
        c.EditorProperties().ComboBox(cb => {
            cb.DataSource = NorthwindDataProvider.GetCategories();
            cb.TextField = "CategoryName";
            cb.ValueField = "CategoryID";
            cb.ValueType = typeof(int);
        });
    });
    settings.Columns.Add(c => {
        c.FieldName = "QuantityPerUnit";
        c.AdaptivePriority = 1;
        c.MinWidth = 150;
        c.MaxWidth = 250;
        c.Width = Unit.Percentage(20);
    });
    settings.Columns.Add(c => {
        c.FieldName = "UnitPrice";
        c.MinWidth = 70;
        c.MaxWidth = 100;
        c.Width = Unit.Percentage(9);
        c.EditorProperties().SpinEdit(sp => {
            sp.DisplayFormatString = "c";
            sp.DisplayFormatInEditMode = true;
            sp.MinValue = 0;
            sp.MaxValue = 60000;
        });
    });
    settings.Columns.Add(c => {
        c.FieldName = "UnitsInStock";
        c.MinWidth = 50;
        c.MaxWidth = 90;
        c.Width = Unit.Percentage(8);
        c.EditorProperties().SpinEdit(sp => {
            sp.NumberType = SpinEditNumberType.Integer;
            sp.MinValue = 0;
            sp.MaxValue = 10000;
        });
    });
    settings.Columns.Add(c => {
        c.FieldName = "Discontinued";
        c.Width = 100;
        c.AdaptivePriority = 2;
        c.EditorProperties().CheckBox(cb => {
            cb.AllowGrayed = true;
            cb.AllowGrayedByClick = false;
        });
    });

    settings.SettingsPager.PageSize = 30;
    settings.SettingsPager.NumericButtonCount = 6;
    settings.ControlStyle.CssClass = "grid";
    settings.Styles.Cell.Wrap = DefaultBoolean.False;
    settings.ClientSideEvents.BeginCallback = "Grid_BeginCallback";

    settings.CellEditorInitialize = (s, e) => {
        ((ASPxEdit)e.Editor).ValidationSettings.Display = Display.Dynamic;
    };
}).SetEditErrorText(ViewData["EditError"] as string).Bind(Model).GetHtml()
