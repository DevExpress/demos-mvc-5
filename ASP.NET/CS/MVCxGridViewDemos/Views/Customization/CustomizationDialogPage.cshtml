@{ Layout = null; } 
@model IEnumerable

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Customization Dialog - ASP.NET MVC GridView Extension</title>
    <style>
        body, form {
            padding: 0;
            margin: 0;
            min-height: 200px;
            min-width: 150px;
        }
    </style>
    @Html.DevExpress().GetStyleSheets(
        new StyleSheet { ExtensionType = ExtensionType.GridView }
    )
    @Html.DevExpress().GetScripts(
        new Script { ExtensionType = ExtensionType.GridView }
    )
</head>
<body>
    @using(Html.BeginForm()) {
        @Html.Partial("CustomizationDialogPagePartial", Model)
    }
</body>
</html>