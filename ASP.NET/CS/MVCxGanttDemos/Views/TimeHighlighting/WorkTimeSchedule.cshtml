@{ DemoHelper.Instance.ControlAreaMaxWidth = Unit.Percentage(100); }

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@section AdditionalResources {
    <style>
        .workTimeLabel {
            font-weight: bold;
        }
        .workTimeDisabledLabel {
            text-decoration: line-through;
            color: lightgray;
        }
    </style>
}

@section DemoOptionsTop {
    <script type="text/javascript">
        function ViewTypeCombo_SelectedIndexChanged(s, e) {
            gantt.SetViewType(s.GetValue());
            if(s.GetValue() < 3) {
                gantt.SetTaskTitlePosition(0);
                lblDailyRules.GetMainElement().classList.remove("workTimeDisabledLabel");
            }
            else {
                gantt.SetTaskTitlePosition(1);
                lblDailyRules.GetMainElement().classList.add("workTimeDisabledLabel");
            }
        }
    </script>
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().ComboBox(settings => {
                settings.Name = "ViewType";
                settings.Properties.Caption = "View Type";
                settings.Properties.ClientSideEvents.SelectedIndexChanged = "ViewTypeCombo_SelectedIndexChanged";
                settings.Theme = DemoHelper.Instance.Theme;
                settings.Properties.ValueType = typeof(int);
                settings.Properties.ValueField = "Value";
                settings.Properties.TextField = "Text";
            }).BindList(GanttDemoOptions.AvailableWorkTimeViewTypes.Select(i => new { Value = (int)i, Text = i.ToString() })).Bind((int)ViewBag.ViewType).GetHtml()
        </div>
        <div class="options-item">
            <span class="workTimeLabel">Working hours: </span>
            @Html.DevExpress().Label(settings => {
               settings.Name = "lblDailyRules";
               settings.Text = "from 08:00 till 11:55 AND from 13:00 till 17:00";
               settings.Properties.EnableClientSideAPI = true;
               settings.Theme = DemoHelper.Instance.Theme;
            }).GetHtml()
            <br />
            <span class="workTimeLabel">Non-working Days: </span>
            @Html.DevExpress().Label(settings => {
               settings.Name = "lblWeeklyRules";
               settings.Text = "Saturday AND Sunday";
               settings.Theme = DemoHelper.Instance.Theme;
            }).GetHtml()
            <br />
            <span class="workTimeLabel">Holidays: </span>
            @Html.DevExpress().Label(settings => {
                settings.Name = "lblYearlyRules";
                settings.Text = "May 27 AND February 14 AND March 8";
                settings.Theme = DemoHelper.Instance.Theme;
            }).GetHtml()
            <br />
        </div>
    </div>
}

@Html.Partial("WorkTimeSchedulePartial")

@section EndDemoRegion {
    @{ Html.EndForm(); }
}