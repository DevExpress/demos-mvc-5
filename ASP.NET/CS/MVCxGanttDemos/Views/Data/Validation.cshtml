@{ DemoHelper.Instance.ControlAreaMaxWidth = Unit.Percentage(100); }

@section AdditionalResources{
    <script type="text/javascript">
        function Submit() {
            $("form").submit();
        }
        function onBeginCallback(s,e) {
            e.customArgs=MVCxClientUtils.GetSerializedEditorValuesInContainer("options");
        }
    </script>
}

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@section DemoOptionsTop {
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().CheckBox(cbSettings =>
            {
                cbSettings.Name = "AutoUpdateParentTasks";
                cbSettings.Text = "Auto Update Parent Tasks";
                cbSettings.Theme = DemoHelper.Instance.Theme;
                cbSettings.ControlStyle.Wrap = DefaultBoolean.False;
                cbSettings.Properties.ClientSideEvents.ValueChanged = "function(s, e) { Submit(); }";
            }).Bind((bool)DemoOptions.AutoUpdateParentTasks).GetHtml()
        </div>
        <div class="options-item">
            @Html.DevExpress().CheckBox(cbSettings =>
            {
                cbSettings.Name = "EnableDependencyValidation";
                cbSettings.Text = "Enable Dependency Validation";
                cbSettings.Theme = DemoHelper.Instance.Theme;
                cbSettings.ControlStyle.Wrap = DefaultBoolean.False;
                cbSettings.Properties.ClientSideEvents.ValueChanged = "function(s, e) { Submit(); }";
            }).Bind((bool)DemoOptions.EnableDependencyValidation).GetHtml()
        </div>
        <div class="options-item">
            @Html.DevExpress().CheckBox(cbSettings =>
            {
                cbSettings.Name = "EnablePredecessorGap";
                cbSettings.Text = "Enable Predecessor Gap";
                cbSettings.Theme = DemoHelper.Instance.Theme;
                cbSettings.ControlStyle.Wrap = DefaultBoolean.False;
                cbSettings.Properties.ClientSideEvents.ValueChanged = "function(s, e) { Submit(); }";
            }).Bind((bool)DemoOptions.EnablePredecessorGap).GetHtml()
        </div>
    </div>
}

@Html.Partial("ValidationPartial")

@section EndDemoRegion {
    @{ Html.EndForm(); }
}

@functions {
    ValidationDemoOptions DemoOptions { get { return ViewBag.ValidationDemoOptions; } }
}
