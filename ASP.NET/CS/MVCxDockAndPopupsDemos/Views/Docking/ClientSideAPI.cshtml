@model PopupControlFeaturesDemoOptions
@{
    DemoHelper.Instance.ControlAreaMaxWidth = Unit.Pixel(600);
    DemoHelper.Instance.ControlOptionsRightBlockWidth = Unit.Pixel(320);
}

@section AdditionalResources {
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/Docking/CSS/ClientSideAPI.css")" />
}

<script type="text/javascript">
    function toggleVisibility(s, e) {
        var panel = getCurrentDockPanel();
        panel.SetVisible(s.GetValue());
    }

    function changeZoneUID() {
        var panel = getCurrentDockPanel(),
            zone = getCurrentDockZone();

        if(zone)
            panel.Dock(zone, panel.GetVisibleIndex());
        else
            panel.MakeFloat();
    }

    function changeVisibleIndex() {
        var panel = getCurrentDockPanel();
        panel.SetVisibleIndex(VisibleIndex.GetValue());
    }

    function showProperties() {
        var panel = getCurrentDockPanel();
        ZoneUID.SetValue(panel.IsDocked() ? panel.GetOwnerZone().zoneUID : 'none');
        PanelVisibility.SetChecked(panel.GetVisible());
        VisibleIndex.SetValue(panel.GetVisibleIndex());
    }

    function getCurrentDockPanel() {
        return manager.GetPanelByUID(PanelUID.GetValue());
    }

    function getCurrentDockZone() {
        return manager.GetZoneByUID(ZoneUID.GetValue());
    }
</script>
@section DemoOptions {
        @Html.DevExpress().FormLayout(s => {
       s.Name = "SettingsFormLayout";
       s.RequiredMarkDisplayMode = RequiredMarkMode.None;
       s.Items.AddGroupItem(g => {
           g.Caption = "Options";
           g.Items.Add(i => {
               i.Caption = "Choose panel";
               i.NestedExtension().ComboBox(cb => {
                   cb.Name = "PanelUID";
                   cb.Properties.DataSource = ClientSideAPIDemoHelper.GetPanelUIDs();
                   cb.Properties.DropDownStyle = DropDownStyle.DropDownList;
                   cb.SelectedIndex = 0;
                   cb.Properties.ClientSideEvents.SelectedIndexChanged = "function(s, e) { showProperties(); }";
               });
           });
           g.Items.Add(i => {
               i.Caption = "Visible index";
               i.NestedExtension().ComboBox(cb => {
                   cb.Name = "VisibleIndex";
                   cb.Properties.DataSource = ClientSideAPIDemoHelper.GetVisibleIndices();
                   cb.Properties.DropDownStyle = DropDownStyle.DropDownList;
                   cb.Properties.ClientSideEvents.SelectedIndexChanged = "function(s, e) { changeVisibleIndex(); }";
               });
           });
           g.Items.Add(i => {
               i.Caption = "Dock to";
               i.NestedExtension().ComboBox(cb => {
                   cb.Name = "ZoneUID";
                   cb.Properties.DataSource = ClientSideAPIDemoHelper.GetZoneUIDs();
                   cb.Properties.DropDownStyle = DropDownStyle.DropDownList;
                   cb.Properties.ClientSideEvents.SelectedIndexChanged = "function(s, e) { changeZoneUID(); }";
                   cb.Properties.ClientSideEvents.Init = "function(s, e) { showProperties(); }";
               });
           });
           g.Items.Add(i => {
               i.Caption = "Visible";
               i.NestedExtension().CheckBox(c => {
                   c.Name = "PanelVisibility";
                   c.Checked = true;
                   c.Properties.ClientSideEvents.CheckedChanged = "toggleVisibility";
               });
           });
       });
       DemoHelper.Instance.PrepareControlOptions(s, new MvcControlOptionsSettings {
           ColumnMinWidth = 250,
           ColumnCountMode = RecalculateColumnCountMode.RootGroup
       });
   }).GetHtml()
}
@Html.DevExpress().DockManager(
    settings => {
        settings.Name = "manager";
        settings.ClientSideEvents.AfterDock = "function(s, e) { showProperties(); }";
        settings.ClientSideEvents.EndPanelDragging = "function(s, e) { showProperties(); }";
        settings.ClientSideEvents.PanelCloseUp = "function(s, e) { showProperties(); }";
    }
).GetHtml()
@Html.DevExpress().DockPanel(
    settings => {
        settings.Name = "panel1";
        settings.PanelUID = "panel1";
        settings.OwnerZoneUID = "zone1";
        settings.VisibleIndex = 0;
        settings.HeaderText = "2D Pie";
        settings.FooterText = "Model: Simple";
        settings.Height = 100;
        settings.Width = 250;
        settings.ShowFooter = true;
        settings.SetContent(() => {
            ViewContext.Writer.Write(
                "<img id=\"panel1Image\" src=\"" + Url.Content("~/Content/Docking/Images/Charts/2DPie.png") + "\" alt=\"\"/>"
            );
        });
        settings.PreRender = (sender, e) => {
            ((MVCxDockPanel)sender).Styles.Content.HorizontalAlign = HorizontalAlign.Center;
        };
    }
).GetHtml()
