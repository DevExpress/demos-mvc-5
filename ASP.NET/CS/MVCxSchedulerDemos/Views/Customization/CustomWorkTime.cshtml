@model SchedulerDataObject

@{ DemoHelper.Instance.ControlAreaMaxWidth = Unit.Percentage(100); }

@section DemoOptionsTop {
    <script type="text/javascript">
        function OnCustomWorkTimeChanged(s, e) {
            scheduler.Refresh();
        };
        function OnBeginCallback(s, e) {
            e.customArgs["isCustomWorkTimeEnabled"] = customWorkTime.GetValue();
        }
    </script>
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().CheckBox(s => {
                s.Name = "customWorkTime";
                s.Text = "Custom work time";
                s.Theme = DemoHelper.Instance.Theme;
                s.Properties.ClientSideEvents.CheckedChanged = "OnCustomWorkTimeChanged";
           }).Bind(ViewData["isCustomWorkTimeEnabled"]).GetHtml()
        </div>
    </div>
}

@Html.Partial("CustomWorkTimePartial", Model)