@model SchedulerDataObject

@{ DemoHelper.Instance.ControlAreaMaxWidth = Unit.Percentage(100); }

@section DemoOptionsTop {
    <script type="text/javascript">
        var createAppointment = false;
        function OnButtonClick(s, e) {
            createAppointment = true;
            scheduler.Refresh();
        }
        function OnSchedulerBeginCallback(s, e) {
            e.customArgs["CreateAppointment"] = createAppointment;
            createAppointment = false;
        }
    </script>
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().Button(
                settings => {
                    settings.Name = "createAppointmentButton";
                    settings.Theme = DemoHelper.Instance.Theme;
                    settings.Text = "Create appointment with reminders";
                    settings.ClientSideEvents.Click = "OnButtonClick";
                }).GetHtml()
        </div>
    </div>
}

@Html.Partial("RemindersPartial", Model)