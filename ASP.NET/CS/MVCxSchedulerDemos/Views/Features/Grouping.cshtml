@model SchedulerDataObject

@{ DemoHelper.Instance.ControlAreaMaxWidth = Unit.Percentage(100); }

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@section DemoOptionsTop {
    <div class="options">
        <div class="options-item">
            @Html.DevExpress().ComboBox(s => {
               s.Name = "GroupType";
               s.Properties.Caption = "Group type";
               s.Theme = DemoHelper.Instance.Theme;
               s.SelectedIndex = 1;
               s.Properties.Items.Add("None", 0);
               s.Properties.Items.Add("Date", 1);
               s.Properties.Items.Add("Resource", 2);
               s.Properties.ClientSideEvents.SelectedIndexChanged = "function(s) { scheduler.SetGroupType(s.GetValue()) }";
           }).GetHtml()
        </div>
    </div>
}

@Html.Partial("GroupingPartial")

@section EndDemoRegion{
    @{ Html.EndForm(); }
}
