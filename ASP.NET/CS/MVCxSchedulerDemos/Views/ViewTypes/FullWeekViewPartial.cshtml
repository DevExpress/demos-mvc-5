@model SchedulerFullWeekViewDemoOptions

@Html.DevExpress().Scheduler(
    settings => {
        settings.Name = "scheduler";
        settings.CallbackRouteValues = new { Controller = "ViewTypes", Action = "FullWeekViewPartial" };
        settings.ActiveViewType = SchedulerViewType.FullWeek;
        settings.GroupType = SchedulerGroupType.Resource;
        settings.Start = new DateTime(2016, 10, 10);

        settings.Views.DayView.Enabled = false;
        settings.Views.WorkWeekView.Enabled = false;
        settings.Views.FullWeekView.Enabled = true;
        settings.Views.WeekView.Enabled = false;
        settings.Views.MonthView.Enabled = false;
        settings.Views.TimelineView.Enabled = false;
        settings.Views.AgendaView.Enabled = false;

        SchedulerDemoHelper.ApplyCommonViewSettings(settings.Views.FullWeekView);

        settings.Views.FullWeekView.ShowAllDayArea = Model.ShowAllDayArea;
        settings.Views.FullWeekView.ShowDayHeaders = Model.ShowDayHeaders;
        settings.Views.FullWeekView.ShowWorkTimeOnly = Model.ShowWorkTimeOnly;

        settings.Views.FullWeekView.AppointmentDisplayOptions.SnapToCellsMode = Model.SnapToCellsMode;
        settings.Views.FullWeekView.AppointmentDisplayOptions.StartTimeVisibility = Model.StartTimeVisibility;
        settings.Views.FullWeekView.AppointmentDisplayOptions.EndTimeVisibility = Model.EndTimeVisibility;
        settings.Views.FullWeekView.AppointmentDisplayOptions.ShowRecurrence = Model.ShowRecurrence;

        settings.OptionsView.AppointmentSelectionAppearanceMode = Model.AppointmentSelectionAppearanceMode;
        settings.OptionsBehavior.ShowViewNavigator = Model.ShowViewNavigator;
        settings.OptionsBehavior.ShowViewVisibleInterval = Model.ShowViewVisibleInterval;
        settings.OptionsBehavior.HighlightSelectionHeaders = Model.HighlightSelectionHeaders;

        settings.Storage.EnableReminders = false;
        settings.Storage.Resources.Assign(SchedulerDemoHelper.DefaultResourceStorage);
        settings.Storage.Appointments.Assign(SchedulerDemoHelper.DefaultAppointmentStorage);
        settings.OptionsCustomization.AllowAppointmentCreate = UsedAppointmentType.None;
        settings.OptionsCustomization.AllowAppointmentEdit = UsedAppointmentType.None;
        settings.OptionsCustomization.AllowAppointmentDelete = UsedAppointmentType.None;
        settings.OptionsToolTips.ShowSelectionToolTip = false;
    }).Bind(Model.Appointments, Model.Resources).GetHtml()