@model SchedulerWeekViewDemoOptions

@Html.DevExpress().FormLayout(settings => {
    settings.Name = "SettingsFormLayout";
    settings.RequiredMarkDisplayMode = RequiredMarkMode.None;

    settings.Items.AddGroupItem(g => {
        g.Caption = "Appointment Layout";

        g.Items.Add(m => m.StartTimeVisibility).NestedExtension().ComboBox(s => {
            s.Properties.Items.Add("Auto", 0);
            s.Properties.Items.Add("Always", 1);
            s.Properties.Items.Add("Never", 2);
        });
        g.Items.Add(m => m.EndTimeVisibility).NestedExtension().ComboBox(s => {
            s.Properties.Items.Add("Auto", 0);
            s.Properties.Items.Add("Always", 1);
            s.Properties.Items.Add("Never", 2);
        });
        g.Items.Add(m => m.ShowRecurrence);
    });

    settings.Items.AddGroupItem(g => {
        g.Caption = "Common options";

        g.Items.Add(m => m.AppointmentSelectionAppearanceMode).NestedExtension().ComboBox(s => {
            s.Properties.Items.Add("Auto", 0);
            s.Properties.Items.Add("BackgroundOpacity", 1);
            s.Properties.Items.Add("BoundaryFrame", 2);
        });
        g.Items.Add(m => m.ShowViewNavigator);
        g.Items.Add(m => m.ShowViewVisibleInterval);
    });

    DemoHelper.Instance.PrepareControlOptions(settings, new MvcControlOptionsSettings {
        ColumnMinWidth = 480,
        ColumnCountMode = RecalculateColumnCountMode.RootGroup
    });

}).Bind(Model).GetHtml()

<div class="apply-button-container">
    @Html.DevExpress().Button(s => {
        s.Name = "ApplyButton";
        s.Text = "Apply Changes";
        s.Theme = DemoHelper.Instance.Theme;
        s.UseSubmitBehavior = true;
    }).GetHtml()
</div>