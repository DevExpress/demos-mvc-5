@{
    DemoHelper.Instance.ControlAreaMaxWidth = Unit.Pixel(450);
}

@section AdditionalResources {
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/jquery.unobtrusive-ajax.min.js")" type="text/javascript"></script>
    <style>
        .dxnbSys {
            width: 100% !important;
            padding: 0 !important;
        }

        .settings {
            margin-bottom: 15px;
        }

        .text {
            font-size: 9pt;
            font-family: tahoma;
        }

            .text > span {
                font-weight: bold;
            }
    </style>
    <script type="text/javascript">
        function submitForm() {
            $("form").submit();
        }
    </script>
}
@{
    Html.EnableClientValidation();
    Html.EnableUnobtrusiveJavaScript();
}

@using (Ajax.BeginRouteForm(null,
                new RouteValueDictionary { { "controller", "NavBar" }, { "action", "DataBindingToXMLPartial" } },
                new AjaxOptions { UpdateTargetId = "componentDiv", OnSuccess = "MVCxClientUtils.FinalizeCallback" })) {

    <div class="settings">
        @Html.DevExpress().ComboBox(
            settings => {
                settings.Name = "ddlXPath";
                settings.Theme = DemoHelper.Instance.Theme;
                settings.Width = Unit.Parse("100%");
                settings.Properties.ValueType = typeof(string);
                settings.Properties.Caption = "Filter:";
                settings.Properties.Items.Add("All", "/Cameras/*");
                settings.Properties.Items.Add("Canon", "/Cameras/*[@Text='Canon']");
                settings.Properties.Items.Add("Nikon", "/Cameras/*[@Text='Nikon']");
                settings.Properties.Items.Add("Olympus", "/Cameras/*[@Text='Olympus']");
                settings.Properties.Items.Add("Sony", "/Cameras/*[@Text='Sony']");
                settings.Properties.Items.Add("Pentax", "/Cameras/*[@Text='Pentax']");
                settings.Properties.ClientSideEvents.ValueChanged = "submitForm";
            }).GetHtml()
    </div>

    <div id="componentDiv">
        @Html.Partial("DataBindingToXMLPartial")
    </div>
}
