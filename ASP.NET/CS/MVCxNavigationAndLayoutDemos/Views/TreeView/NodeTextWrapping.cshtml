@model bool?

@{
    DemoHelper.Instance.ControlAreaMaxWidth = 700;
}

@section AdditionalResources {
    <style>
        .custom-checkbox {
            margin-bottom: 20px;
        }
    </style>
    <script>
        function submitForm() {
            $("form").submit();
        }
    </script>
}

@section StartDemoRegion {
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

@Html.DevExpress().CheckBox(settings => {
    settings.Name = "chEnableNodeTextWrapping";
    settings.Theme = DemoHelper.Instance.Theme;
    settings.Text = "EnableNodeTextWrapping";
    settings.ControlStyle.CssClass = "custom-checkbox";
    settings.Checked = Model.Value;
    settings.Properties.ClientSideEvents.CheckedChanged = "submitForm";
}).GetHtml()

@Html.DevExpress().Splitter(
    settings => {
        settings.Name = "splitter";
        settings.Width = Unit.Percentage(100);
        settings.Panes.Add(pane => {
            pane.Name = "first";
            pane.ScrollBars = ScrollBars.Auto;
            pane.Size = Unit.Pixel(220);
            pane.MinSize = Unit.Pixel(185);
            pane.SetContent(() => {
                @Html.RenderPartial("NodeTextWrappingPartial", Model);
            });
        });
        settings.Panes.Add(pane => {
            pane.Name = "second";
        });
    }).GetHtml()

@section EndDemoRegion{
    @{ Html.EndForm(); }
}