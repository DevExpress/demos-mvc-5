@Html.DevExpress().PageControl(
    settings =>
    {
        settings.Name = "pcCallbacks";
        settings.CallbackRouteValues = new { Controller = "TabControl", Action = "CallbacksPartial" };
        settings.Width = Unit.Percentage(100);
        settings.ControlStyle.CssClass = "dxtcAligned dxtcFixed horizontal-center-aligned";
        settings.EnableTabScrolling = true;
        settings.TabAlign = TabAlign.Justify;
        settings.TabPosition = TabPosition.Bottom;
        settings.ActivateTabPageAction = ActivateTabPageAction.MouseOver;

        settings.TabPages.Add("Original").SetContent(() =>
        {
            ViewContext.Writer.Write(
                "<img class=\"dxtmImage\" alt=\"\" src=\"" + Url.Content("~/Content/TabControl/Hands/Original.jpg") + "\" />"
            );
        });
        settings.TabPages.Add("Cross-Process").SetContent(() =>
        {
            ViewContext.Writer.Write(
                "<img class=\"dxtmImage\" alt=\"\" src=\"" + Url.Content("~/Content/TabControl/Hands/CrossProcess.jpg") + "\" />"
            );
        });
        settings.TabPages.Add("Sepia").SetContent(() =>
        {
            ViewContext.Writer.Write(
                "<img class=\"dxtmImage\" alt=\"\" src=\"" + Url.Content("~/Content/TabControl/Hands/Sepia.jpg") + "\" />"
            );
        });
        settings.ActiveTabIndex = 0;
    }).GetHtml()