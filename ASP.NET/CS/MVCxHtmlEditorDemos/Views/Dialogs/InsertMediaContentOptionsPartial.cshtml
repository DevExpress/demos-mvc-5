@model HtmlEditorInsertMediaContentDemoOptions

@Html.DevExpress().FormLayout(settings => {
    settings.Name = "demoOptions";
    settings.ShowItemCaptionColon = false;
    settings.RequiredMarkDisplayMode = RequiredMarkMode.None;
    settings.SettingsItemCaptions.Location = LayoutItemCaptionLocation.Right;

    var contentFilteringGroupItem = settings.Items.AddGroupItem(itemSettings => {
        itemSettings.Caption = "Content Filtering";
        itemSettings.GroupBoxDecoration = GroupBoxDecoration.HeadingLine;
        itemSettings.ParentContainerStyle.Paddings.PaddingRight = Unit.Pixel(20);
    });
    
    contentFilteringGroupItem.Items.Add(itemSettings => {
        itemSettings.FieldName = "AllowHTML5MediaElements";
        itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.CheckBox;
    });
    contentFilteringGroupItem.Items.Add(itemSettings => {
        itemSettings.FieldName = "AllowObjectAndEmbedElements";
        itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.CheckBox;
    });
    contentFilteringGroupItem.Items.Add(itemSettings => {
        itemSettings.FieldName = "AllowYouTubeVideoIFrames";
        itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.CheckBox;
    });
    DemoHelper.Instance.PrepareControlOptions(settings, new MvcControlOptionsSettings {
        ColumnMinWidth = 350,
        ColumnCountMode = RecalculateColumnCountMode.ChildGroups
    });
}).Bind(Model).GetHtml()
<div class="apply-button-container">
    @Html.DevExpress().Button(s => {
    s.Name = "ApplyButton";
    s.Text = "Apply Changes";
    s.Theme = DemoHelper.Instance.Theme;
    s.UseSubmitBehavior = true;
}).GetHtml()
</div>