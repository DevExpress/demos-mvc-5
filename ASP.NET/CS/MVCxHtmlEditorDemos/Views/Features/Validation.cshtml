@model ValidationDemoModel
@{
    DemoHelper.Instance.ControlAreaMaxWidth = Unit.Pixel(1000);
}
@section StartDemoRegion{
    @{ Html.BeginForm(); }
}

@Html.AntiForgeryToken()

<script type="text/javascript">
    function ValidationHandler(s, e) {
        if(e.html.length > '@(ValidationDemoModel.MaxLength)') {
            e.isValid = false;
            e.errorText = "@(new MvcHtmlString(ValidationDemoModel.MaxLengthErrorMessage))";
        }
    }
    function HtmlChangedHandler(s, e) {
        $("#contentLength").html(s.GetHtml().length);
    }
</script>
@Html.Partial("ValidationPartial", Model)
<div style="margin: 8px 0;">
    Length of HTML code representing the Editor's content (in characters): <b id="contentLength">@(Model.DemoHtml.Length)</b>
</div>
<div class="apply-button-container">
    @Html.DevExpress().Button(s => {
       s.Name = "Submit";
       s.Text = "Submit";
       s.Theme = DemoHelper.Instance.Theme;
       s.UseSubmitBehavior = true;
   }).GetHtml()
</div>





@section EndDemoRegion{
    @{ Html.EndForm(); }
}

