@model string
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0" />
    <title>Adaptive Layout - ASP.NET MVC Diagram</title>
    <title>Adaptive Layout - ASP.NET Diagram Control</title>
    <style>
        html, body, form {
            padding: 0;
            margin: 0;
            height: 100%;
        }

        form .diagram {
            border: none;
        }
    </style>

    @Html.DevExpress().GetStyleSheets(
        new StyleSheet { ExtensionType = ExtensionType.Diagram }
    )
    <link href="~/Content/deviceViewerContent.css" rel="stylesheet" />
    <script src="@Url.Content("~/Scripts/jquery.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")" type="text/javascript"></script>
    @Html.DevExpress().GetScripts(
        new Script { ExtensionType = ExtensionType.Diagram }
    )
</head>
<body>
    @using(Html.BeginForm()) {
        @Html.DevExpress().Diagram(settings => {
            settings.Name = "Diagram";
            settings.Height = Unit.Percentage(100);
            settings.ControlStyle.CssClass = "diagram";
            settings.AutoZoom = DiagramAutoZoomMode.FitContent;
        }).Import(Model).GetHtml()
    }
</body>
</html>